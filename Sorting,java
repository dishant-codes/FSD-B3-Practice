class Sorting{


    public static void bubbleSort(int[] arr){

        int n = arr.length;

        boolean swapped;

        for(int i =0; i<n; i++){
            swapped = false;

            //  2, 3, 1, 4, 6

            //  2 > 3 = no swap
            //  3 > 6 = no swap
            //  6 > 1 = swap
            //  6 > 4 = swap


            //  2, 1, 3, 4, 6
            
            //  2 > 3 = no swap
            //  3 > 1 = swap
            //  3 > 4 = no swap
    

            //  1, 2, 3, 4, 6

            //  2 > 1 = swap 
            //  2 > 3 = no swap



            //  1, 2, 3, 4, 6

            //  1 > 2 = no swap


            for(int j=0;j < n - 1 - i;j++){

                if(arr[j] > arr[j+1]){

                    int temp = arr[j];

                    arr[j] = arr[j+1];

                    arr[j+1] = temp;

                    swapped = true;

                }
            }


            if(!swapped){
                break;
            }

        }

    }


    public static void main(String[] args){


        int[] arr = {2, 3, 1, 4, 6};

        System.out.println("before swap");
        for(int value: arr){
            System.out.println(value);
        }

        bubbleSort(arr);

        System.out.println("after swap")
        for(int value: arr){
            System.out.println(value);
        }



    }

}